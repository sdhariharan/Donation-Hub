rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /donation-images/{donorId}/{donationId}/{fileName} {
      // Download URLs are rendered to authenticated donors and organizations.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == donorId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if request.auth != null && request.auth.uid == donorId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
